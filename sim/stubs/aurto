#!/usr/bin/env bash
# Sim stub: records argv, then replays a configured response.
#
# aurto must never be executed by this tool. The log is the assertion surface:
# a scenario fails if /var/log/sim-aurto.log is non-empty after `init`.
set -uo pipefail

tool=${0##*/}
printf '%s\n' "$*" >>"/var/log/sim-$tool.log"

if [[ -f "/etc/sim/$tool.exit" ]]; then
    exit "$(cat "/etc/sim/$tool.exit")"
fi
[[ -f "/etc/sim/$tool.out" ]] && cat "/etc/sim/$tool.out"
[[ -f "/etc/sim/$tool.err" ]] && cat "/etc/sim/$tool.err" >&2
exit 0
