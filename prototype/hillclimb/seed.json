{
  "name": "Atlas",
  "screens": {
    "dashboard": {
      "first": "verdict",
      "verdict": [
        "summary",
        "drift",
        "next_action"
      ],
      "blocks": [
        "verdict",
        "pending",
        "disk",
        "timer",
        "lock",
        "trust",
        "caches"
      ],
      "primary": "install",
      "states": [
        "empty"
      ]
    },
    "updates": {
      "first": "table",
      "primary": "install",
      "states": [
        "empty"
      ],
      "columns": [
        "package",
        "repo",
        "installed",
        "available",
        "size",
        "cached"
      ],
      "inspector": [
        "name",
        "repo",
        "cached",
        "size",
        "exact_command"
      ]
    },
    "install": {
      "first": "detail",
      "primary": "install",
      "states": [
        "blocked"
      ],
      "gates": [
        "root",
        "lock",
        "official_list",
        "aur_list",
        "news",
        "trust",
        "yay",
        "disk",
        "attestation"
      ]
    },
    "caches": {
      "first": "table",
      "primary": "apply",
      "states": [
        "empty"
      ],
      "columns": [
        "path",
        "size",
        "policy"
      ]
    },
    "doctor": {
      "first": "table",
      "read_only": true,
      "states": [
        "unavailable"
      ],
      "columns": [
        "check",
        "verdict",
        "detail",
        "fix"
      ]
    },
    "activity": {
      "first": "table",
      "read_only": true,
      "states": [
        "empty"
      ],
      "columns": [
        "time",
        "level",
        "message"
      ]
    },
    "settings": {
      "first": "table",
      "read_only": true,
      "states": [
        "empty"
      ],
      "columns": [
        "setting",
        "value",
        "source"
      ]
    },
    "help": {
      "first": "summary",
      "summary": true
    },
    "palette": {
      "first": "summary",
      "summary": true
    }
  },
  "report": {
    "drift": [
      "last_fetch",
      "last_install"
    ],
    "sections": {
      "official": {
        "data": true,
        "error": true
      },
      "aur": {
        "data": true,
        "error": true
      },
      "disk": {
        "data": true,
        "error": true
      },
      "lock": {
        "data": true
      },
      "caches": {
        "data": true
      },
      "timer": {
        "data": true
      },
      "state": {
        "data": true
      },
      "trust": {
        "data": true
      },
      "doctor": {
        "data": true
      }
    },
    "post_install": [
      "exit_code"
    ]
  },
  "actions": [
    {
      "id": "install",
      "label": "Install",
      "keys": [
        "i"
      ],
      "danger": "destructive",
      "plan": true,
      "exact_argv": true,
      "confirm": true
    },
    {
      "id": "fetch",
      "label": "Fetch",
      "keys": [
        "f"
      ],
      "danger": "mutating",
      "plan": true,
      "exact_argv": true,
      "confirm": true
    },
    {
      "id": "clean",
      "label": "Clean",
      "keys": [
        "c"
      ],
      "danger": "destructive",
      "plan": true,
      "exact_argv": true,
      "confirm": true
    },
    {
      "id": "filter",
      "label": "Filter updates",
      "keys": [
        "f"
      ],
      "danger": "readonly"
    },
    {
      "id": "quit",
      "label": "Quit",
      "keys": [
        "q"
      ],
      "danger": "readonly"
    }
  ],
  "keymap": {
    "bindings": [
      {
        "scope": "global",
        "key": "f",
        "action": "fetch"
      },
      {
        "scope": "panel",
        "key": "f",
        "action": "filter"
      },
      {
        "scope": "global",
        "key": "c",
        "action": "clean"
      },
      {
        "scope": "panel",
        "key": "c",
        "action": "clear"
      },
      {
        "scope": "global",
        "key": "i",
        "action": "install"
      }
    ],
    "collisions": [
      "f",
      "c"
    ]
  },
  "glyphs": {
    "semantics": [
      "ok",
      "warn",
      "block",
      "error",
      "running",
      "skipped"
    ],
    "ascii": {
      "ok": "+",
      "warn": "!",
      "block": "#",
      "error": "x",
      "running": "*",
      "skipped": "-"
    }
  },
  "tables": {
    "numeric_align": "right",
    "text_align": "left"
  },
  "layout": {
    "border": "single",
    "spacing": 1,
    "truncation": "none"
  },
  "themes": [
    "ansi"
  ],
  "panels": {
    "registry": true,
    "list": [
      "dashboard",
      "updates",
      "install",
      "caches",
      "doctor",
      "activity",
      "settings"
    ],
    "add_steps": 0,
    "golden_tests": false
  },
  "config": {},
  "help": {
    "mental_model": [
      "download",
      "install",
      "partial upgrade"
    ],
    "contextual": true
  },
  "palette": {
    "all_actions": false
  },
  "footer": {
    "from_registry": false
  },
  "states": [
    "empty",
    "loading"
  ],
  "first_run": false,
  "blocked": {
    "gate": true,
    "fix": true,
    "exit_code": true
  },
  "install_teaches": [
    "news"
  ],
  "render_once": {},
  "ascii": {
    "covers_borders": false,
    "covers_gauges": false,
    "covers_arrows": false,
    "covers_checkboxes": false,
    "covers_markers": false
  },
  "color_alone": true,
  "responsive": {
    "breakpoints": [
      80,
      120
    ],
    "clipping": true
  },
  "reduced_motion": false,
  "absolute_timestamps": false,
  "disabled_reasons": false,
  "empty_next_command": false,
  "actions_single_source": false,
  "theme_registry": false,
  "section_enum": false,
  "activity_records": [],
  "post_install_cases": [
    "success"
  ],
  "clean": {
    "dry_run_default": true,
    "absolute_exe": false,
    "env_warning": false
  },
  "trust": {
    "missing": "warn",
    "empty": "refuse"
  },
  "news": {
    "attestation": "none"
  },
  "gates": [
    "root",
    "lock",
    "official_list",
    "aur_list",
    "news",
    "trust",
    "yay",
    "disk",
    "attestation"
  ]
}
